/* Generated by scripts/urdf2mpc.py. Position MPC: ERK + NLS + SQP_RTI. */
#include "acados_solver_willow_mpc.h"
#include "willow_mpc_model/willow_mpc_gravity.h"
#include <stdlib.h>
#include <string.h>

/* CasADi uses an integer memory slot; acados passes a void pointer. Adapt
 * explicitly instead of calling through incompatible function pointers. */
#define DECLARE_CASADI(name) \
    extern int name(const double **, double **, int *, double *, int); \
    extern int name##_n_in(void); \
    extern int name##_n_out(void); \
    extern const int *name##_sparsity_in(int); \
    extern const int *name##_sparsity_out(int); \
    extern int name##_work(int *, int *, int *, int *); \
    static int name##_adapter(const double **arg, double **res, \
                             int *iw, double *w, void *mem) { \
        (void)mem; \
        return name(arg, res, iw, w, 0); \
    }

DECLARE_CASADI(willow_mpc_expl_ode_fun)
DECLARE_CASADI(willow_mpc_expl_vde_forw)
DECLARE_CASADI(willow_mpc_expl_vde_adj)
DECLARE_CASADI(willow_mpc_cost_y_fun)
DECLARE_CASADI(willow_mpc_cost_y_fun_jac_ut_xt)
DECLARE_CASADI(willow_mpc_cost_y_hess)
DECLARE_CASADI(willow_mpc_cost_y_e_fun)
DECLARE_CASADI(willow_mpc_cost_y_e_fun_jac_ut_xt)
DECLARE_CASADI(willow_mpc_cost_y_e_hess)
#undef DECLARE_CASADI

#define CREATE_CASADI(fun, name) do { \
    (fun).casadi_fun = name##_adapter; \
    (fun).casadi_n_in = name##_n_in; \
    (fun).casadi_n_out = name##_n_out; \
    (fun).casadi_sparsity_in = name##_sparsity_in; \
    (fun).casadi_sparsity_out = name##_sparsity_out; \
    (fun).casadi_work = name##_work; \
    external_function_external_param_casadi_create(&(fun), &ext_opts); \
} while (0)

willow_mpc_solver_capsule *willow_mpc_acados_create_capsule(void) {
    return calloc(1, sizeof(willow_mpc_solver_capsule));
}

int willow_mpc_acados_free_capsule(willow_mpc_solver_capsule *cap) {
    free(cap);
    return 0;
}

int willow_mpc_acados_create(willow_mpc_solver_capsule *cap) {
    if (!cap || cap->nlp_solver_plan) return -1;
    const int N = WILLOW_MPC_N;
    cap->nlp_solver_plan = ocp_nlp_plan_create(N);
    ocp_nlp_plan_t *plan = cap->nlp_solver_plan;
    plan->nlp_solver = SQP_RTI;
    plan->ocp_qp_solver_plan.qp_solver = FULL_CONDENSING_HPIPM;
    plan->regularization = NO_REGULARIZE;
    plan->globalization = FIXED_STEP;
    for (int i = 0; i <= N; ++i) {
        plan->nlp_cost[i] = NONLINEAR_LS;
        plan->nlp_constraints[i] = BGH;
        if (i < N) {
            plan->nlp_dynamics[i] = CONTINUOUS_MODEL;
            plan->sim_solver_plan[i].sim_solver = ERK;
        }
    }
    cap->nlp_config = ocp_nlp_config_create(*plan);
    cap->nlp_dims = ocp_nlp_dims_create(cap->nlp_config);
    ocp_nlp_config *config = cap->nlp_config;
    ocp_nlp_dims *dims = cap->nlp_dims;

    int nx[WILLOW_MPC_N + 1], nu[WILLOW_MPC_N + 1];
    int zeros[WILLOW_MPC_N + 1] = {0};
    for (int i = 0; i <= N; ++i) {
        nx[i] = WILLOW_MPC_NX;
        nu[i] = i < N ? WILLOW_MPC_NU : 0;
    }
    ocp_nlp_dims_set_opt_vars(config, dims, "nx", nx);
    ocp_nlp_dims_set_opt_vars(config, dims, "nu", nu);
    ocp_nlp_dims_set_opt_vars(config, dims, "nz", zeros);
    ocp_nlp_dims_set_opt_vars(config, dims, "ns", zeros);
    ocp_nlp_dims_set_opt_vars(config, dims, "np", zeros);
    for (int i = 0; i <= N; ++i) {
        int ny = i < N ? WILLOW_MPC_NY : WILLOW_MPC_NYN;
        int nbxe = i == 0 ? WILLOW_MPC_NX : 0;
        ocp_nlp_dims_set_cost(config, dims, i, "ny", &ny);
        ocp_nlp_dims_set_constraints(config, dims, i, "nbx", &nx[i]);
        ocp_nlp_dims_set_constraints(config, dims, i, "nbu", &nu[i]);
        ocp_nlp_dims_set_constraints(config, dims, i, "nbxe", &nbxe);
    }

    cap->nlp_in = ocp_nlp_in_create(config, dims);
    cap->nlp_out = ocp_nlp_out_create(config, dims);
    ocp_nlp_in *in = cap->nlp_in;
    ocp_nlp_out *out = cap->nlp_out;
    external_function_opts ext_opts;
    external_function_opts_set_to_default(&ext_opts);
    ext_opts.external_workspace = false;
    for (int i = 0; i < N; ++i) {
        CREATE_CASADI(cap->expl_ode_fun[i], willow_mpc_expl_ode_fun);
        CREATE_CASADI(cap->expl_vde_for[i], willow_mpc_expl_vde_forw);
        CREATE_CASADI(cap->expl_vde_adj[i], willow_mpc_expl_vde_adj);
        CREATE_CASADI(cap->cost_y_fun[i], willow_mpc_cost_y_fun);
        CREATE_CASADI(cap->cost_y_fun_jac_ut_xt[i], willow_mpc_cost_y_fun_jac_ut_xt);
        CREATE_CASADI(cap->cost_y_hess[i], willow_mpc_cost_y_hess);
        ocp_nlp_dynamics_model_set_external_param_fun(config, dims, in, i,
            "expl_ode_fun", &cap->expl_ode_fun[i]);
        ocp_nlp_dynamics_model_set_external_param_fun(config, dims, in, i,
            "expl_vde_forw", &cap->expl_vde_for[i]);
        ocp_nlp_dynamics_model_set_external_param_fun(config, dims, in, i,
            "expl_vde_adj", &cap->expl_vde_adj[i]);
        ocp_nlp_cost_model_set_external_param_fun(config, dims, in, i,
            "nls_y_fun", &cap->cost_y_fun[i]);
        ocp_nlp_cost_model_set_external_param_fun(config, dims, in, i,
            "nls_y_fun_jac", &cap->cost_y_fun_jac_ut_xt[i]);
        ocp_nlp_cost_model_set_external_param_fun(config, dims, in, i,
            "nls_y_hess", &cap->cost_y_hess[i]);
    }
    CREATE_CASADI(cap->cost_y_e_fun, willow_mpc_cost_y_e_fun);
    CREATE_CASADI(cap->cost_y_e_fun_jac_ut_xt, willow_mpc_cost_y_e_fun_jac_ut_xt);
    CREATE_CASADI(cap->cost_y_e_hess, willow_mpc_cost_y_e_hess);
    ocp_nlp_cost_model_set_external_param_fun(config, dims, in, N,
        "nls_y_fun", &cap->cost_y_e_fun);
    ocp_nlp_cost_model_set_external_param_fun(config, dims, in, N,
        "nls_y_fun_jac", &cap->cost_y_e_fun_jac_ut_xt);
    ocp_nlp_cost_model_set_external_param_fun(config, dims, in, N,
        "nls_y_hess", &cap->cost_y_e_hess);

    double W[WILLOW_MPC_NY * WILLOW_MPC_NY] = {${W}};
    double We[WILLOW_MPC_NYN * WILLOW_MPC_NYN] = {${We}};
    double yref[WILLOW_MPC_NY] = {0};
    double lbx[WILLOW_MPC_NX] = {${lbx}};
    double ubx[WILLOW_MPC_NX] = {${ubx}};
    double lbu[WILLOW_MPC_NU] = {${lbu}};
    double ubu[WILLOW_MPC_NU] = {${ubu}};
    double x0[WILLOW_MPC_NX] = {0};
    double u0[WILLOW_MPC_NU] = {0};
    double dt = WILLOW_MPC_DT;
    int idxbx[WILLOW_MPC_NX], idxbu[WILLOW_MPC_NU];
    for (int i = 0; i < WILLOW_MPC_NX; ++i) idxbx[i] = i;
    for (int i = 0; i < WILLOW_MPC_NU; ++i) idxbu[i] = i;
    for (int i = 0; i <= N; ++i) {
        ocp_nlp_cost_model_set(config, dims, in, i, "W", i < N ? W : We);
        ocp_nlp_cost_model_set(config, dims, in, i, "yref", yref);
        ocp_nlp_constraints_model_set(config, dims, in, out, i, "idxbx", idxbx);
        ocp_nlp_constraints_model_set(config, dims, in, out, i, "lbx", i ? lbx : x0);
        ocp_nlp_constraints_model_set(config, dims, in, out, i, "ubx", i ? ubx : x0);
        ocp_nlp_out_set(config, dims, out, in, i, "x", x0);
        if (i < N) {
            ocp_nlp_in_set(config, dims, in, i, "Ts", &dt);
            ocp_nlp_cost_model_set(config, dims, in, i, "scaling", &dt);
            ocp_nlp_constraints_model_set(config, dims, in, out, i, "idxbu", idxbu);
            ocp_nlp_constraints_model_set(config, dims, in, out, i, "lbu", lbu);
            ocp_nlp_constraints_model_set(config, dims, in, out, i, "ubu", ubu);
            ocp_nlp_out_set(config, dims, out, in, i, "u", u0);
        }
    }
    ocp_nlp_constraints_model_set(config, dims, in, out, 0, "idxbxe", idxbx);

    cap->nlp_opts = ocp_nlp_solver_opts_create(config, dims);
    double lm = 1e-4;
    int stages = 4, steps = 1, qp_iter_max = 50;
    ocp_nlp_solver_opts_set(config, cap->nlp_opts, "qp_hpipm_mode", "ROBUST");
    ocp_nlp_solver_opts_set(config, cap->nlp_opts, "levenberg_marquardt", &lm);
    ocp_nlp_solver_opts_set(config, cap->nlp_opts, "qp_iter_max", &qp_iter_max);
    for (int i = 0; i < N; ++i) {
        ocp_nlp_solver_opts_set_at_stage(config, cap->nlp_opts, i,
            "dynamics_num_stages", &stages);
        ocp_nlp_solver_opts_set_at_stage(config, cap->nlp_opts, i,
            "dynamics_num_steps", &steps);
    }
    cap->nlp_solver = ocp_nlp_solver_create(config, dims, cap->nlp_opts, in);
    int status = ocp_nlp_precompute(cap->nlp_solver, in, out);
    cap->initialized = status == ACADOS_SUCCESS;
    return status;
}
#undef CREATE_CASADI

int willow_mpc_acados_gravity(const double *x, double *gravity) {
    const double *args[willow_mpc_gravity_SZ_ARG] = {x};
    double *res[willow_mpc_gravity_SZ_RES] = {gravity};
    int iw[willow_mpc_gravity_SZ_IW + 1];
    double w[willow_mpc_gravity_SZ_W + 1];
    return willow_mpc_gravity(args, res, iw, w, 0);
}

int willow_mpc_acados_solve(willow_mpc_solver_capsule *cap) {
    if (!cap || !cap->initialized) return -1;
    return ocp_nlp_solve(cap->nlp_solver, cap->nlp_in, cap->nlp_out);
}

int willow_mpc_acados_free(willow_mpc_solver_capsule *cap) {
    if (!cap) return 0;
    if (cap->nlp_solver) ocp_nlp_solver_destroy(cap->nlp_solver);
    if (cap->nlp_opts) ocp_nlp_solver_opts_destroy(cap->nlp_opts);
    if (cap->nlp_in) ocp_nlp_in_destroy(cap->nlp_in);
    if (cap->nlp_out) ocp_nlp_out_destroy(cap->nlp_out);
    if (cap->nlp_dims) ocp_nlp_dims_destroy(cap->nlp_dims);
    if (cap->nlp_config) ocp_nlp_config_destroy(cap->nlp_config);
    if (cap->nlp_solver_plan) ocp_nlp_plan_destroy(cap->nlp_solver_plan);
    for (int i = 0; i < WILLOW_MPC_N; ++i) {
        external_function_external_param_casadi_free(&cap->expl_ode_fun[i]);
        external_function_external_param_casadi_free(&cap->expl_vde_for[i]);
        external_function_external_param_casadi_free(&cap->expl_vde_adj[i]);
        external_function_external_param_casadi_free(&cap->cost_y_fun[i]);
        external_function_external_param_casadi_free(&cap->cost_y_fun_jac_ut_xt[i]);
        external_function_external_param_casadi_free(&cap->cost_y_hess[i]);
    }
    external_function_external_param_casadi_free(&cap->cost_y_e_fun);
    external_function_external_param_casadi_free(&cap->cost_y_e_fun_jac_ut_xt);
    external_function_external_param_casadi_free(&cap->cost_y_e_hess);
    memset(cap, 0, sizeof(*cap));
    return 0;
}

ocp_nlp_in *willow_mpc_acados_get_nlp_in(willow_mpc_solver_capsule *c) { return c->nlp_in; }
ocp_nlp_out *willow_mpc_acados_get_nlp_out(willow_mpc_solver_capsule *c) { return c->nlp_out; }
ocp_nlp_solver *willow_mpc_acados_get_nlp_solver(willow_mpc_solver_capsule *c) { return c->nlp_solver; }
ocp_nlp_config *willow_mpc_acados_get_nlp_config(willow_mpc_solver_capsule *c) { return c->nlp_config; }
void *willow_mpc_acados_get_nlp_opts(willow_mpc_solver_capsule *c) { return c->nlp_opts; }
ocp_nlp_dims *willow_mpc_acados_get_nlp_dims(willow_mpc_solver_capsule *c) { return c->nlp_dims; }
ocp_nlp_plan_t *willow_mpc_acados_get_nlp_plan(willow_mpc_solver_capsule *c) { return c->nlp_solver_plan; }
