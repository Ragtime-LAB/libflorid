#pragma once
// Generated by scripts/urdf2mpc.py. Position MPC, DOF=${nq}, N=${horizon}, dt=${dt}s.
#include "acados_solver_willow_mpc.h"
#include "florid/Exceptions.hpp"
#include <algorithm>
#include <new>
#include <string>

namespace florid {

struct ${traits_name} {
    static constexpr int kNX = ${nx};
    static constexpr int kNU = ${nu};
    static constexpr int kDOF = ${nq};
    static constexpr int kHorizon = ${horizon};
    static constexpr float kDt = ${dt}f;
    static constexpr float kQLower[kDOF] = {${q_lower}};
    static constexpr float kQUpper[kDOF] = {${q_upper}};
    static constexpr float kTauLimit[kNU] = {${tau_limit}};
    static constexpr float kDqLimit[kDOF] = {${dq_limit}};

    static void* create() {
        auto* s_cap = willow_mpc_acados_create_capsule();
        if (!s_cap) throw std::bad_alloc();
        const int s_status = willow_mpc_acados_create(s_cap);
        if (s_status != ACADOS_SUCCESS) {
            destroy(s_cap);
            throw ControlException("MPC initialization failed: " + std::to_string(s_status));
        }
        return s_cap;
    }

    static void destroy(void* s_cap) {
        auto* s_c = static_cast<willow_mpc_solver_capsule*>(s_cap);
        willow_mpc_acados_free(s_c);
        willow_mpc_acados_free_capsule(s_c);
    }

    static void setInitialState(void* s_cap, const float* s_x0) {
        auto* s_c = static_cast<willow_mpc_solver_capsule*>(s_cap);
        double s_x[kNX];
        for (int i = 0; i < kNX; ++i) s_x[i] = s_x0[i];
        if (willow_mpc_acados_gravity(s_x, s_c->gravity_reference) != 0)
            throw ControlException("MPC gravity evaluation failed");
        ocp_nlp_constraints_model_set(s_c->nlp_config, s_c->nlp_dims, s_c->nlp_in,
            s_c->nlp_out, 0, "lbx", s_x);
        ocp_nlp_constraints_model_set(s_c->nlp_config, s_c->nlp_dims, s_c->nlp_in,
            s_c->nlp_out, 0, "ubx", s_x);
        // Seed a new solve at the measurement, then reuse the previous horizon.
        // Reinitializing every RTI step discards the previous linearization point.
        double s_u[kNU] = {};
        for (int i = 0; i < kNU; ++i)
            s_u[i] = std::clamp(s_c->gravity_reference[i],
                               -double(kTauLimit[i]), double(kTauLimit[i]));
        if (!s_c->warm_started) {
            for (int i = 0; i <= kHorizon; ++i) {
                ocp_nlp_out_set(s_c->nlp_config, s_c->nlp_dims, s_c->nlp_out,
                    s_c->nlp_in, i, "x", s_x);
                if (i < kHorizon)
                    ocp_nlp_out_set(s_c->nlp_config, s_c->nlp_dims, s_c->nlp_out,
                        s_c->nlp_in, i, "u", s_u);
            }
        }
        ocp_nlp_out_set(s_c->nlp_config, s_c->nlp_dims, s_c->nlp_out,
            s_c->nlp_in, 0, "x", s_x);
    }

    // This OCP tracks position only; reference is [x, y, z] in model-base axes.
    static void setReference(void* s_cap, const float* s_pos_ref) {
        auto* s_c = static_cast<willow_mpc_solver_capsule*>(s_cap);
        double s_yref[WILLOW_MPC_NY] = {};
        for (int i = 0; i < 3; ++i) s_yref[i] = s_pos_ref[i];
        // Penalize torque relative to gravity compensation, not zero torque.
        // This makes a stationary, reachable reference an equilibrium.
        for (int i = 0; i < kNU; ++i) s_yref[3 + kDOF + i] = s_c->gravity_reference[i];
        for (int i = 0; i <= kHorizon; ++i)
            ocp_nlp_cost_model_set(s_c->nlp_config, s_c->nlp_dims,
                s_c->nlp_in, i, "yref", s_yref);
    }

    static int solve(void* s_cap) {
        auto* s_c = static_cast<willow_mpc_solver_capsule*>(s_cap);
        const int s_status = willow_mpc_acados_solve(s_c);
        s_c->warm_started = s_status == ACADOS_SUCCESS;
        if (s_status != ACADOS_SUCCESS)
            ocp_nlp_solver_reset_qp_memory(s_c->nlp_solver, s_c->nlp_in, s_c->nlp_out);
        return s_status;
    }

    static void getOptimalQ(void* s_cap, float* s_q_out) {
        auto* s_c = static_cast<willow_mpc_solver_capsule*>(s_cap);
        double s_x[kNX];
        // Stage 0 is constrained to the measurement. Command the next state.
        ocp_nlp_out_get(s_c->nlp_config, s_c->nlp_dims, s_c->nlp_out, 1, "x", s_x);
        for (int i = 0; i < kDOF; ++i) s_q_out[i] = static_cast<float>(s_x[i]);
    }

    static void getOptimalDq(void* s_cap, float* s_dq_out) {
        auto* s_c = static_cast<willow_mpc_solver_capsule*>(s_cap);
        double s_x[kNX];
        ocp_nlp_out_get(s_c->nlp_config, s_c->nlp_dims, s_c->nlp_out, 1, "x", s_x);
        for (int i = 0; i < kDOF; ++i) s_dq_out[i] = static_cast<float>(s_x[kDOF + i]);
    }
};

} // namespace florid
